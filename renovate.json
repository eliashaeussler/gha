{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"local>eliashaeussler/renovate-config"
	],
	"packageRules": [
		{
			"matchDepNames": [
				"eliashaeussler/gha"
			],
			"pinDigests": false
		},
		{
			"matchFileNames": [
				".github/**"
			],
			"assignAutomerge": true,
			"automergeType": "pr"
		}
	]
}
